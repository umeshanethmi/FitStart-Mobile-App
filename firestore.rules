rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function isCoachRole(role) {
      return role in ['coach', 'Coach', 'Trainer', 'trainer'];
    }

    function isTherapistRole(role) {
      return role in ['therapist', 'Therapist'];
    }

    function matchesExpertRole(userRole, expertRole) {
      return (expertRole == 'coach' && isCoachRole(userRole)) ||
        (expertRole == 'therapist' && isTherapistRole(userRole));
    }

    function isApprovedExpert() {
      return signedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        (
          isCoachRole(get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role) ||
          isTherapistRole(get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role)
        ) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isApproved == true;
    }

    function isApprovedExpertUid(expertUid, expertRole) {
      return exists(/databases/$(database)/documents/users/$(expertUid)) &&
        matchesExpertRole(
          get(/databases/$(database)/documents/users/$(expertUid)).data.role,
          expertRole
        ) &&
        get(/databases/$(database)/documents/users/$(expertUid)).data.isApproved == true &&
        expertRole in ['coach', 'therapist'];
    }

    function assignedRequest(userUid, requestId) {
      return exists(/databases/$(database)/documents/users/$(userUid)/support_requests/$(requestId)) &&
        get(/databases/$(database)/documents/users/$(userUid)/support_requests/$(requestId)).data.expertId == request.auth.uid;
    }

    function chatDoc(chatId) {
      return get(/databases/$(database)/documents/support_chats/$(chatId));
    }

    match /users/{uid} {
      allow get: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly([
          'uid', 'email', 'name', 'role', 'isApproved', 'createdAt',
          'updatedAt', 'goal', 'height', 'weight', 'age', 'gender',
          'activityLevel', 'bmi', 'settings', 'specialization', 'bio',
          'photoUrl', 'experience', 'isAvailable', 'available'
        ])
        && request.resource.data.get('uid', uid) == uid
        && request.resource.data.get('role', 'user') in [
          'user', 'Beginner'
        ]
        && request.resource.data.get('isApproved', false) == false;
      allow update: if signedIn() && request.auth.uid == uid
        && (
          request.resource.data.get('role', null) == resource.data.get('role', null) ||
          (
            resource.data.get('role', null) == null &&
            request.resource.data.get('role', 'user') in [
              'user', 'Beginner'
            ]
          )
        )
        && request.resource.data.get('email', null) == resource.data.get('email', null)
        && request.resource.data.get('uid', uid) == resource.data.get('uid', uid)
        && request.resource.data.get('isApproved', false) == resource.data.get('isApproved', false)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'role', 'name', 'goal', 'height', 'weight', 'age', 'gender',
          'activityLevel', 'bmi', 'settings', 'updatedAt', 'uid',
          'specialization', 'bio', 'photoUrl', 'experience', 'isAvailable',
          'available'
        ]);
      allow update: if isAdmin()
        && request.resource.data.role in [
          'user', 'coach', 'Coach', 'therapist', 'Therapist', 'Trainer', 'trainer'
        ]
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'role', 'isApproved', 'updatedAt'
        ])
        && request.resource.data.get(
          'isApproved',
          resource.data.get('isApproved', false)
        ) is bool
        && (request.resource.data.role != 'user' ||
          request.resource.data.get('isApproved', false) == false);
      allow delete: if isAdmin();

      match /achievements/{achievementId} {
        allow get, list: if signedIn() &&
          (request.auth.uid == uid || isAdmin());
        allow create: if signedIn()
          && request.auth.uid == uid
          && request.resource.data.keys().hasAll([
            'achievementId', 'rewardPoints', 'earnedAt', 'progressAtUnlock'
          ])
          && request.resource.data.keys().hasOnly([
            'achievementId', 'rewardPoints', 'earnedAt', 'progressAtUnlock'
          ])
          && request.resource.data.achievementId == achievementId
          && request.resource.data.rewardPoints is int
          && request.resource.data.rewardPoints >= 0
          && request.resource.data.earnedAt is timestamp
          && request.resource.data.progressAtUnlock is number;
        allow update, delete: if isAdmin();
      }

      match /account_deletion_requests/{requestId} {
        allow get, list: if signedIn() &&
          (request.auth.uid == uid || isAdmin());
        allow create: if signedIn()
          && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['status', 'requestedAt'])
          && request.resource.data.status == 'requested'
          && request.resource.data.requestedAt is timestamp;
        allow update, delete: if isAdmin();
      }
    }

    match /workout_plans/{planId} {
      allow get, list: if signedIn() &&
        (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid;
      allow update: if signedIn()
        && (resource.data.userId == request.auth.uid || isAdmin())
        && request.resource.data.userId == resource.data.userId;
      allow delete: if signedIn() &&
        (resource.data.userId == request.auth.uid || isAdmin());
    }

    match /workout_schedules/{scheduleId} {
      allow get, list: if signedIn() &&
        (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid;
      allow update: if signedIn()
        && (resource.data.userId == request.auth.uid || isAdmin())
        && request.resource.data.userId == resource.data.userId;
      allow delete: if signedIn() &&
        (resource.data.userId == request.auth.uid || isAdmin());
    }

    match /expert_directory/{expertUid} {
      allow get, list: if signedIn()
        && resource.data.isApproved == true
        && resource.data.role in ['coach', 'therapist'];
      allow create, update: if signedIn()
        && request.auth.uid == expertUid
        && request.resource.data.keys().hasAll([
          'name', 'role', 'specialization', 'bio', 'photoUrl',
          'experience', 'isAvailable', 'isApproved', 'updatedAt'
        ])
        && request.resource.data.keys().hasOnly([
          'name', 'role', 'specialization', 'bio', 'photoUrl',
          'experience', 'isAvailable', 'isApproved', 'updatedAt'
        ])
        && request.resource.data.isApproved == true
        && request.resource.data.role in ['coach', 'therapist']
        && isApprovedExpertUid(expertUid, request.resource.data.role)
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 120
        && request.resource.data.specialization is string
        && request.resource.data.specialization.size() <= 160
        && request.resource.data.bio is string
        && request.resource.data.bio.size() <= 2000
        && request.resource.data.photoUrl is string
        && request.resource.data.photoUrl.size() <= 2048
        && request.resource.data.experience is int
        && request.resource.data.experience >= 0
        && (request.resource.data.isAvailable == null ||
          request.resource.data.isAvailable is bool)
        && request.resource.data.updatedAt is timestamp;
      allow delete: if isAdmin() ||
        (signedIn() && request.auth.uid == expertUid &&
          !isApprovedExpertUid(expertUid, resource.data.role));
    }

    match /users/{uid}/support_requests/{requestId} {
      allow get, list: if signedIn() && (
        request.auth.uid == uid ||
        isAdmin() ||
        (isApprovedExpert() && resource.data.expertId == request.auth.uid)
      );
      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.keys().hasAll([
          'userId', 'expertId', 'expertRole', 'expertName', 'specialization',
          'userName', 'message', 'status', 'createdAt', 'lastActivityAt',
          'lastMessage'
        ])
        && request.resource.data.keys().hasOnly([
          'userId', 'expertId', 'expertRole', 'expertName', 'specialization',
          'userName', 'message', 'status', 'createdAt', 'lastActivityAt',
          'lastMessage'
        ])
        && request.resource.data.userId == uid
        && request.resource.data.expertId is string
        && request.resource.data.expertRole is string
        && isApprovedExpertUid(
          request.resource.data.expertId,
          request.resource.data.expertRole
        )
        && request.resource.data.message is string
        && request.resource.data.message.size() >= 10
        && request.resource.data.message.size() <= 2000
        && request.resource.data.status == 'submitted'
        && request.resource.data.createdAt is timestamp
        && request.resource.data.lastActivityAt is timestamp
        && request.resource.data.lastMessage == request.resource.data.message;
      allow update: if isApprovedExpert()
        && resource.data.expertId == request.auth.uid
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.expertId == resource.data.expertId
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['lastMessage', 'lastActivityAt', 'status'])
        && request.resource.data.lastMessage is string
        && request.resource.data.lastMessage.size() <= 2000
        && request.resource.data.lastActivityAt is timestamp
        && request.resource.data.status in ['in_progress', 'resolved'];
      allow delete: if isAdmin();

      match /replies/{replyId} {
        allow get, list: if signedIn() && (
          request.auth.uid == uid ||
          isAdmin() ||
          (isApprovedExpert() && assignedRequest(uid, requestId))
        );
        allow create: if isApprovedExpert()
          && assignedRequest(uid, requestId)
          && request.resource.data.keys().hasOnly([
            'senderId', 'senderRole', 'text', 'createdAt'
          ])
          && request.resource.data.senderId == request.auth.uid
          && matchesExpertRole(
            get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role,
            request.resource.data.senderRole
          )
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 2000
          && request.resource.data.createdAt is timestamp;
        allow update, delete: if false;
      }
    }

    match /{path=**}/support_requests/{requestId} {
      allow get, list: if signedIn() && (
        isAdmin() ||
        request.auth.uid == resource.data.userId ||
        (isApprovedExpert() && resource.data.expertId == request.auth.uid)
      );
      allow update: if isApprovedExpert()
        && resource.data.expertId == request.auth.uid
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.expertId == resource.data.expertId
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['lastMessage', 'lastActivityAt', 'status'])
        && request.resource.data.lastMessage is string
        && request.resource.data.lastMessage.size() <= 2000
        && request.resource.data.lastActivityAt is timestamp
        && request.resource.data.status in ['in_progress', 'resolved'];
    }

    match /support_chats/{chatId} {
      function isParticipant(chatData) {
        return signedIn()
          && request.auth.uid in chatData.participantIds
          && (
            request.auth.uid == chatData.userId ||
            (
              request.auth.uid == chatData.expertId &&
              matchesExpertRole(
                get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role,
                chatData.expertRole
              ) &&
              isApprovedExpert()
            )
          );
      }

      allow get: if signedIn() && (
        !exists(/databases/$(database)/documents/support_chats/$(chatId)) ||
        isParticipant(resource.data)
      );
      allow list: if signedIn() && (
        request.auth.uid == resource.data.userId ||
        (
          isApprovedExpert() &&
          resource.data.expertId == request.auth.uid &&
          matchesExpertRole(
            get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role,
            resource.data.expertRole
          )
        )
      );
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly([
          'chatId', 'userId', 'expertId', 'expertRole', 'userName',
          'expertName', 'participantIds', 'lastMessage', 'lastMessageId',
          'lastMessageAt', 'createdAt', 'updatedAt', 'status'
        ])
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.expertId != request.auth.uid
        && !isApprovedExpert()
        && request.resource.data.chatId == chatId
        && (
          (
            request.resource.data.userId < request.resource.data.expertId &&
            chatId == request.resource.data.userId + '_' +
              request.resource.data.expertId
          ) ||
          (
            request.resource.data.expertId < request.resource.data.userId &&
            chatId == request.resource.data.expertId + '_' +
              request.resource.data.userId
          )
        )
        && isApprovedExpertUid(
          request.resource.data.expertId,
          request.resource.data.expertRole
        )
        && exists(
          /databases/$(database)/documents/expert_directory/$(request.resource.data.expertId)
        )
        && get(
          /databases/$(database)/documents/expert_directory/$(request.resource.data.expertId)
        ).data.isApproved == true
        && get(
          /databases/$(database)/documents/expert_directory/$(request.resource.data.expertId)
        ).data.role == request.resource.data.expertRole
        && request.resource.data.participantIds.size() == 2
        && request.auth.uid in request.resource.data.participantIds
        && request.resource.data.expertId in request.resource.data.participantIds
        && request.resource.data.participantIds.hasAll([
          request.resource.data.userId,
          request.resource.data.expertId
        ])
        && request.resource.data.status == 'active'
        && request.resource.data.lastMessage == ''
        && request.resource.data.lastMessageId == ''
        && request.resource.data.userName is string
        && request.resource.data.expertName is string
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp
        && request.resource.data.lastMessageAt is timestamp;
      allow update: if isParticipant(resource.data)
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.expertId == resource.data.expertId
        && request.resource.data.participantIds == resource.data.participantIds
        && request.resource.data.expertRole == resource.data.expertRole
        && request.resource.data.chatId == resource.data.chatId
        && request.resource.data.userName == resource.data.userName
        && request.resource.data.expertName == resource.data.expertName
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly([
            'lastMessage', 'lastMessageId', 'lastMessageAt', 'updatedAt', 'status'
          ])
        && request.resource.data.lastMessage is string
        && request.resource.data.lastMessage.size() <= 2000
        && request.resource.data.lastMessageId is string
        && existsAfter(
          /databases/$(database)/documents/support_chats/$(chatId)/messages/$(request.resource.data.lastMessageId)
        )
        && getAfter(
          /databases/$(database)/documents/support_chats/$(chatId)/messages/$(request.resource.data.lastMessageId)
        ).data.senderId == request.auth.uid
        && getAfter(
          /databases/$(database)/documents/support_chats/$(chatId)/messages/$(request.resource.data.lastMessageId)
        ).data.text == request.resource.data.lastMessage
        && request.resource.data.lastMessageAt is timestamp
        && request.resource.data.updatedAt is timestamp
        && request.resource.data.status == 'active';
      allow delete: if isAdmin();

      match /messages/{messageId} {
        allow get, list: if isParticipant(chatDoc(chatId).data);
        allow create: if signedIn()
          && request.resource.data.senderId == request.auth.uid
          && isParticipant(chatDoc(chatId).data)
          && request.resource.data.keys().hasOnly([
            'senderId', 'text', 'createdAt', 'readAt'
          ])
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 2000
          && request.resource.data.createdAt is timestamp
          && request.resource.data.readAt == null;
        allow update: if isParticipant(chatDoc(chatId).data)
          && resource.data.senderId != request.auth.uid
          && request.resource.data.senderId == resource.data.senderId
          && request.resource.data.text == resource.data.text
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['readAt'])
          && request.resource.data.readAt is timestamp;
        allow delete: if isAdmin();
      }
    }
  }
}
